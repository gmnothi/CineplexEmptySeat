NODE_ENV=production
PORT=4173

# Set this in your host's private environment settings.
CINEPLEX_API_KEY=
APP_USER_AGENT=EmptyScreens/1.0 (your-email@example.com)

# Used when a visitor searches without a postal code.
DEFAULT_LAT=43.6532
DEFAULT_LNG=-79.3832

DEFAULT_THEATRES=8
MAX_THEATRES=12
API_RATE_LIMIT=45
API_RATE_WINDOW_MS=60000
FETCH_TIMEOUT_MS=12000
UPSTREAM_CACHE_TTL_MS=180000
COMPUTED_CACHE_TTL_MS=90000
CACHE_MAX_ENTRIES=1200
